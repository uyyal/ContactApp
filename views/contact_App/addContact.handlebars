<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Contact</title>

  <style>
    /* Global Styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    /* Contact Form Wrapper */
    .contact {
      font-family: 'Arial', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background: #f4f7fa;
    }

    /* Form Container Styling */
    .contactform {
      background: #fff;
      border-radius: 12px;
      padding: 30px;
      width: 400px;
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
      text-align: center;
      max-width: 100%;
    }

    /* Heading Style */
    .contactform h1 {
      font-size: 24px;
      color: #ff6a88;
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* Label Styling */
    .contactform label {
      display: block;
      margin: 10px 0 5px;
      font-size: 14px;
      color: #333;
      font-weight: bold;
      text-align: left;
    }

    /* Input and Select Styling */
    .contactform input,
    .contactform select {
      width: 100%;
      padding: 10px;
      margin-bottom: 15px;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 14px;
      background-color: #f9f9f9;
      box-sizing: border-box;
      transition: 0.3s ease-in-out;
    }

    /* Focused Input and Select */
    .contactform input:focus,
    .contactform select:focus {
      outline: none;
      border-color: #ff758c;
      box-shadow: 0 0 5px rgba(255, 117, 140, 0.5);
    }

    /* Button Styling */
    .contactform .btn1 {
      background: linear-gradient(90deg, #ff6a88, #ff758c);
      color: #fff;
      border: none;
      padding: 12px 20px;
      width: 100%;
      border-radius: 6px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s ease-in-out;
    }

    /* Button Hover Effect */
    .contactform .btn1:hover {
      background: linear-gradient(90deg, #ff758c, #ff7eb3);
      box-shadow: 0 4px 8px rgba(255, 117, 140, 0.3);
    }

    /* Button Active Effect */
    .contactform .btn1:active {
      transform: scale(0.98);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .contactform {
        padding: 20px;
        width: 90%;
      }

      .contactform h1 {
        font-size: 22px;
      }

      .contactform label {
        font-size: 13px;
      }

      .contactform input,
      .contactform select,
      .contactform .btn1 {
        font-size: 15px;
      }
    }

    @media (max-width: 480px) {
      .contactform {
        padding: 15px;
        width: 95%;
      }

      .contactform h1 {
        font-size: 20px;
      }

      .contactform label {
        font-size: 12px;
      }

      .contactform input,
      .contactform select,
      .contactform .btn1 {
        font-size: 14px;
      }
    }
  </style>
</head>
<body>
  <div class="contact">
    <div class="contactform">
      <h1>Add a Contact</h1>
      <form action="/api/form" method="post">
        <label for="fname">First Name</label>
        <input type="text" name="fname" id="fname" placeholder="Enter First Name" />

        <label for="lname">Last Name</label>
        <input type="text" name="lname" id="lname" placeholder="Enter Last Name" />

        <label for="nmbr">Mobile Number</label>
        <input type="number" name="nmbr" id="nmbr" placeholder="Enter Mobile Number" />

        <label for="loc">Saving Location</label>
        <select name="loc" id="loc">
          <option value="mobile">mobile</option>
          <option value="sim">sim</option>
          <option value="email">email</option>
        </select>

        <button class="btn1" type="submit">SUBMIT</button>
      </form>
    </div>
  </div>
</body>
</html>
